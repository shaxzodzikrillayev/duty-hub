# ─────────────────────────────────────────────────────────────
#  Duty Hub 5 «Г» — переменные окружения
#  Скопируйте файл в `.env` и НЕ коммитьте его в git.
# ─────────────────────────────────────────────────────────────

# Секрет для подписи JWT-сессий. ОБЯЗАТЕЛЬНО замените в проде:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-3f9a1c7b52e8461d

# Время жизни сессии
JWT_TTL=7d

# Порт и режим сервера
PORT=4000
NODE_ENV=development

# Разрешённые источники для CORS (через запятую). Пусто = same-origin только.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Данные для первичного заполнения базы (используются только командой db:reset)
SEED_CURATOR_FIRST_NAME=Нилюфар
SEED_CURATOR_LAST_NAME=Абдусаматова
SEED_CURATOR_PASSWORD=Curator12345

# Путь к файлу базы данных SQLite
DATABASE_PATH=./data/dutyhub.db
